<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Analyseur en Coordonnées Parallèles Pro</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Style personnalisé pour les axes D3, lignes et curseurs */
    .axis line, .axis path {
      stroke: #475569;
      stroke-width: 1.5px;
    }
    .axis text {
      fill: #94a3b8;
      font-size: 11px;
      font-weight: 500;
      user-select: none;
    }
    .brush .selection {
      fill: #38bdf8;
      fill-opacity: 0.25;
      stroke: #38bdf8;
      stroke-width: 1.5px;
      rx: 3px;
      cursor: pointer;
    }
    .brush .handle {
      fill: #0284c7;
      stroke: #f8fafc;
      stroke-width: 1.5px;
      rx: 2px;
    }
    
    /* Styles d'état pour les courbes */
    .line-active {
      stroke: #38bdf8 !important;
      stroke-opacity: 0.85 !important;
      stroke-width: 1.8px !important;
    }
    .line-inactive {
      stroke: #334155 !important;
      stroke-opacity: 0.12 !important;
      stroke-width: 1px !important;
    }
    .line-highlight {
      stroke: #f43f5e !important;
      stroke-opacity: 1 !important;
      stroke-width: 3.5px !important;
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 3px;
    }
  </style>
</head>
<body class="h-full flex flex-col font-sans overflow-hidden bg-slate-950 text-slate-100">

  <!-- En-tête -->
  <header class="bg-slate-900 border-b border-slate-800 px-5 py-2.5 flex items-center justify-between shrink-0 shadow-md">
    <div class="flex items-center space-x-3">
      <div class="p-1.5 bg-brand-600/20 text-brand-400 rounded-lg border border-brand-500/30">
        <i class="fa-solid fa-chart-multigraph text-lg"></i>
      </div>
      <div>
        <h1 class="text-sm font-bold tracking-wide text-white flex items-center gap-2">
          Graphique d'Axes Parallèles
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20">Blazor Hybrid Ready</span>
        </h1>
        <p class="text-[11px] text-slate-400">Glisser pour filtrer &bull; <strong class="text-brand-400 font-semibold">Double-cliquer sur un curseur pour le supprimer</strong></p>
      </div>
    </div>

    <!-- Actions & Stats -->
    <div class="flex items-center space-x-3">
      <div class="bg-slate-950 border border-slate-800 rounded-md px-3 py-1 flex items-center gap-3 text-xs">
        <span class="text-slate-400">Courbes sélectionnées : <strong id="statActiveCount" class="text-brand-400">0</strong> / <span id="statTotalCount">0</span></span>
        <div class="w-24 bg-slate-800 rounded-full h-1.5 overflow-hidden">
          <div id="statProgressBar" class="bg-brand-400 h-1.5 rounded-full transition-all duration-300" style="width: 100%"></div>
        </div>
      </div>

      <button id="btnResetFilters" class="px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-md border border-slate-700 transition flex items-center gap-1.5 shadow-sm">
        <i class="fa-solid fa-rotate-left text-slate-400"></i> Réinitialiser Curseurs
      </button>

      <button id="btnShowCode" class="px-3 py-1.5 text-xs font-medium bg-brand-600 hover:bg-brand-500 text-white rounded-md transition shadow-md shadow-brand-600/20 flex items-center gap-1.5">
        <i class="fa-brands fa-windows"></i> Code Blazor Hybrid (WPF)
      </button>
    </div>
  </header>

  <!-- Zone de Graphique -->
  <main class="flex-1 relative w-full h-full bg-slate-950" id="plotContainer">
    <div id="svgWrapper" class="absolute inset-0 w-full h-full"></div>
  </main>

  <!-- Modal pour intégration C# / Blazor Hybrid -->
  <div id="codeModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-200">
    <div class="bg-slate-900 border border-slate-800 rounded-xl w-11/12 max-w-4xl max-h-[85vh] flex flex-col shadow-2xl overflow-hidden">
      
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-950">
        <div class="flex items-center space-x-3">
          <div class="p-2 bg-purple-500/20 text-purple-400 rounded-lg">
            <i class="fa-solid fa-code text-xl"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-white">Intégration Blazor Hybrid (WPF + BlazorWebView)</h3>
            <p class="text-xs text-slate-400">Comment appeler ce composant d3.js depuis ton composant Blazor Razor</p>
          </div>
        </div>
        <button id="btnCloseModal" class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <div class="p-6 overflow-y-auto space-y-6 text-sm text-slate-300">
        <div>
          <h4 class="font-bold text-white text-base mb-2 flex items-center gap-2">
            <i class="fa-solid fa-cube text-brand-400"></i> Composant Blazor : <code class="text-brand-300">ParallelCoordinatesChart.razor</code>
          </h4>
          <p class="text-xs text-slate-400 mb-3">
            Dans ton projet Blazor Hybrid, tu peux utiliser cet interop JS simple avec <code class="text-amber-300">IJSRuntime</code> pour injecter tes données C# vers le composant graph D3 :
          </p>
          <div class="bg-slate-950 p-4 rounded-lg border border-slate-800 font-mono text-xs overflow-x-auto text-sky-300">
            <pre>@inject IJSRuntime JS
@implements IAsyncDisposable

&lt;div id="svgWrapper" style="width: 100%; height: 100%; min-height: 500px;"&gt;&lt;/div&gt;

@code {
    [Parameter] public IEnumerable&lt;object&gt; Data { get; set; }
    [Parameter] public EventCallback&lt;List&lt;string&gt;&gt; OnFilterChanged { get; set; }

    private DotNetObjectReference&lt;ParallelCoordinatesChart&gt;? dotNetHelper;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetHelper = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ParallelChart.init", dotNetHelper, Data);
        }
    }

    [JSInvokable]
    public void OnSelectionUpdated(List&lt;string&gt; selectedIds)
    {
        OnFilterChanged.InvokeAsync(selectedIds);
    }

    public async ValueTask DisposeAsync()
    {
        dotNetHelper?.Dispose();
    }
}</pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Jeu de données de démonstration
    const currentData = Array.from({ length: 220 }, (_, i) => {
      const hp = Math.round(50 + Math.random() * 250);
      const weight = Math.round(1500 + hp * 12 + Math.random() * 800);
      const mpg = Math.round(Math.max(8, 45 - (hp * 0.12) - (weight * 0.003) + Math.random() * 6));
      const accel = Math.round((20 - hp * 0.05 + Math.random() * 3) * 10) / 10;
      const year = 1970 + Math.floor(Math.random() * 12);
      const cyl = hp > 180 ? 8 : (hp > 110 ? 6 : 4);
      return { id: `Item_${i+1}`, Consommation_MPG: mpg, Cylindres: cyl, Puissance_HP: hp, Poids_kg: weight, Accélération: accel, Année: year };
    });

    const firstRow = currentData[0];
    const dimensions = Object.keys(firstRow).filter(k => k !== 'id' && typeof firstRow[k] === 'number');
    
    // Dictionnaire de filtres actifs : { dimensionName: [minVal, maxVal] }
    let activeFilters = {};

    let margin = { top: 40, right: 60, bottom: 30, left: 60 };
    let width = 0;
    let height = 0;
    let svg, gPlot;
    let yScales = {};
    let xScale;
    let brushes = {};

    window.addEventListener('DOMContentLoaded', () => {
      document.getElementById('statTotalCount').textContent = currentData.length;
      setupEventListeners();
      initChartLayout();
      updateChartDimensions();
      renderPlot();

      window.addEventListener('resize', () => {
        if (svg) {
          updateChartDimensions();
          renderPlot();
        }
      });
    });

    function setupEventListeners() {
      document.getElementById('btnResetFilters').addEventListener('click', () => {
        resetAllFilters();
      });

      // Modal
      const modal = document.getElementById('codeModal');
      document.getElementById('btnShowCode').addEventListener('click', () => {
        modal.classList.remove('hidden');
        setTimeout(() => modal.classList.remove('opacity-0'), 10);
      });
      document.getElementById('btnCloseModal').addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      function closeModal() {
        modal.classList.add('opacity-0');
        setTimeout(() => modal.classList.add('hidden'), 200);
      }
    }

    function initChartLayout() {
      const container = document.getElementById('svgWrapper');
      container.innerHTML = '';

      svg = d3.select('#svgWrapper')
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%');

      gPlot = svg.append('g');
    }

    function updateChartDimensions() {
      const container = document.getElementById('svgWrapper');
      const rect = container.getBoundingClientRect();
      width = Math.max(300, rect.width - margin.left - margin.right);
      height = Math.max(200, rect.height - margin.top - margin.bottom);

      gPlot.attr('transform', `translate(${margin.left},${margin.top})`);
    }

    function renderPlot() {
      // 1. Échelles Y
      yScales = {};
      dimensions.forEach(dim => {
        const domain = d3.extent(currentData, d => d[dim]);
        const padding = (domain[1] - domain[0]) * 0.05 || 1;
        yScales[dim] = d3.scaleLinear()
          .domain([domain[0] - padding, domain[1] + padding])
          .range([height, 0]);
      });

      // 2. Échelle X
      xScale = d3.scalePoint()
        .domain(dimensions)
        .range([0, width])
        .padding(0.15);

      // Générateur de lignes
      function path(d) {
        return d3.line()(dimensions.map(p => [xScale(p), yScales[p](d[p])]));
      }

      gPlot.selectAll('*').remove();

      // --- Layer 1 : Courbes (Couleur unique uniforme) ---
      const linesGroup = gPlot.append('g').attr('class', 'lines');

      linesGroup.selectAll('path')
        .data(currentData, d => d.id)
        .enter()
        .append('path')
        .attr('d', path)
        .attr('fill', 'none')
        .attr('class', 'line-active transition-all duration-150')
        .on('mouseenter', function(event, d) {
          // Survol de la courbe s'il est actif
          if (d3.select(this).classed('line-active')) {
            d3.select(this).classed('line-highlight', true).raise();
          }
        })
        .on('mouseleave', function() {
          d3.select(this).classed('line-highlight', false);
        });

      // --- Layer 2 : Axes verticaux ---
      const axesGroup = gPlot.selectAll('.dimension-axis')
        .data(dimensions)
        .enter()
        .append('g')
        .attr('class', 'dimension-axis')
        .attr('transform', d => `translate(${xScale(d)},0)`);

      // Tracer les règles d'axes
      axesGroup.append('g')
        .attr('class', 'axis')
        .each(function(d) {
          d3.select(this).call(d3.axisLeft(yScales[d]).ticks(6).tickFormat(d3.format(".2s")));
        });

      // Titres des axes
      axesGroup.append('text')
        .attr('y', -15)
        .attr('text-anchor', 'middle')
        .attr('class', 'fill-slate-200 font-semibold text-xs tracking-wide cursor-default')
        .text(d => d.replace('_', ' '));

      // --- Layer 3 : D3 Brushes (Curseurs) ---
      brushes = {};
      dimensions.forEach(dim => {
        const brush = d3.brushY()
          .extent([[-12, 0], [12, height]])
          .on('brush end', (event) => brushHandler(event, dim));

        brushes[dim] = brush;

        const brushG = gPlot.append('g')
          .attr('class', `brush brush-${dim}`)
          .attr('transform', `translate(${xScale(dim)},0)`)
          .call(brush);

        // Supprimer le curseur au double-clic
        brushG.selectAll('.selection, .overlay')
          .on('dblclick', function(event) {
            event.stopPropagation();
            removeSingleBrush(dim);
          });

        // Restaurer filtres si redimensionnement
        if (activeFilters[dim]) {
          const y0 = yScales[dim](activeFilters[dim][1]); // Max (en haut)
          const y1 = yScales[dim](activeFilters[dim][0]); // Min (en bas)
          brushG.call(brush.move, [y0, y1]);
        }
      });

      updateFilteredLines();
    }

    // Gestion de la sélection du curseur
    function brushHandler(event, dimension) {
      if (!event.selection) {
        delete activeFilters[dimension];
      } else {
        const [y0, y1] = event.selection;
        // Remarque : yScales est inversé (0 est en haut)
        const valMax = yScales[dimension].invert(y0);
        const valMin = yScales[dimension].invert(y1);
        activeFilters[dimension] = [valMin, valMax];
      }
      updateFilteredLines();
    }

    // Supprimer un curseur unique
    function removeSingleBrush(dimension) {
      delete activeFilters[dimension];
      if (brushes[dimension]) {
        gPlot.select(`.brush-${dimension}`).call(brushes[dimension].move, null);
      }
      updateFilteredLines();
    }

    // Réinitialiser tous les filtres
    function resetAllFilters() {
      activeFilters = {};
      dimensions.forEach(dim => {
        if (brushes[dim]) {
          gPlot.select(`.brush-${dim}`).call(brushes[dim].move, null);
        }
      });
      updateFilteredLines();
    }

    // Filtrage strict : la courbe DOIT valider TOUS les curseurs
    function updateFilteredLines() {
      let activeCount = 0;
      const activeIds = [];
      const filterKeys = Object.keys(activeFilters);

      gPlot.selectAll('.lines path')
        .each(function(d) {
          // Vérification stricte : la donnée doit être dans la plage pour CHAQUE axe filtré
          let isMatch = true;

          for (let i = 0; i < filterKeys.length; i++) {
            const dim = filterKeys[i];
            const [min, max] = activeFilters[dim];
            const val = d[dim];

            // Tolerence de précision pour éviter les bugs d'arrondi aux bornes exactes
            if (val < min - 0.00001 || val > max + 0.00001) {
              isMatch = false;
              break; // Invalide dès qu'un axe est hors borne
            }
          }

          if (isMatch) {
            d3.select(this)
              .classed('line-inactive', false)
              .classed('line-active', true);
            activeCount++;
            activeIds.push(d.id);
          } else {
            d3.select(this)
              .classed('line-active', false)
              .classed('line-inactive', true);
          }
        });

      // Mettre à jour la barre de statistiques
      const ratio = Math.round((activeCount / currentData.length) * 100);
      document.getElementById('statActiveCount').textContent = activeCount;
      document.getElementById('statProgressBar').style.width = `${ratio}%`;

      // Envoi de la sélection à Blazor si connecté
      if (window.dotNetReference) {
        window.dotNetReference.invokeMethodAsync('OnSelectionUpdated', activeIds);
      }
    }
  </script>
</body>
</html>

